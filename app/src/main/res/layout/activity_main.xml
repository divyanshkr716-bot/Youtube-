<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="18dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="YT Auto Shorts" android:textSize="26sp"
            android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/status" android:text="Ready" android:paddingTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/pickPhotos" android:text="1. Select Photos"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/syncTelegram" android:text="2. Sync Telegram Channel"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/connectYoutube" android:text="3. Connect YouTube"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/generate" android:text="4. Generate Short"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/upload" android:text="5. Upload Latest (Private)"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/schedule" android:text="Enable Daily Automation"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/settings" android:text="Settings"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="\nImportant: YouTube's own Add sound can be used after upload. This app creates silent Shorts."
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
