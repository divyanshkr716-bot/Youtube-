<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="18dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Settings" android:textSize="24sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/tgToken" android:hint="Telegram bot token" android:inputType="textPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/tgChat" android:hint="Telegram channel @username or chat ID"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/tgLimit" android:hint="Telegram sync limit (default 20)" android:inputType="number"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/youKey" android:hint="You.com API key" android:inputType="textPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/youTopic" android:hint="Topic / niche (e.g. gaming, facts)"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/titlePrefix" android:hint="Optional title prefix"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/privacy" android:hint="Privacy: private / unlisted / public" android:text="private"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/category" android:hint="YouTube category ID" android:text="22"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/photosPerShort" android:hint="Photos per Short (3-10)" android:text="6" android:inputType="number"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/secondsPerPhoto" android:hint="Seconds per photo" android:text="2" android:inputType="numberDecimal"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/scheduleTimes" android:hint="Daily times, e.g. 09:00,13:00,19:00"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/save" android:text="Save Settings"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
